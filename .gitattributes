* text=auto
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
# Benchmark fixture/reference data carries byte-level contracts (CRLF/BOM);
# store and check it out verbatim, with no EOL normalization.
benchmarks/**/fixture/** -text
benchmarks/**/reference/** -text
